[Unit]
Description=giantmem session ingest

[Service]
Type=oneshot
ExecStart=%h/.local/bin/giantmem db ingest --sessions-only
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
StandardOutput=append:%h/.cache/giantmem/session-sweep.out
StandardError=append:%h/.cache/giantmem/session-sweep.err
